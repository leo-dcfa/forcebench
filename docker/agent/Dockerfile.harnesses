# Forcebench agent sandbox with more harnesses: the agent image (opencode), plus Claude Code and pi.
#
# Built on the agent image, so every harness runs with the same tools around it (shell, git,
# Python, Node) and opencode is the very same build. The network rules are the agent image's: an
# internal Docker network whose only other member is the model proxy. See docs/agent-track.md.
ARG BASE=forcebench-agent
FROM ${BASE}

USER root

# Claude Code, as its npm package installs it: the native binary in the
# @anthropic-ai/claude-code-<platform> package Anthropic publishes, checked against the SHA-512
# integrity the npm registry records.
ARG CLAUDE_CODE_VERSION=2.1.289
ARG CLAUDE_CODE_SHA512_ARM64=sha512-kzZKgmlPjtxeCl3jR4eO+BVwy4hJq/pApB2vWFgrjAGR1jOphhS6GJaU1XjZYGbJITSoeaWxHnD1xQ2EWVZLHw==
ARG CLAUDE_CODE_SHA512_X64=sha512-I23SaSYE8vSwFbJ+Tc0mRlzvJmRQNaiyBUXK/K5R6BVr2lOoCdMI2SJR4N6xiVYy6yyIt39JNiyvPHoiOymyyw==

RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      arm64) target=linux-arm64; want="$CLAUDE_CODE_SHA512_ARM64" ;; \
      amd64) target=linux-x64; want="$CLAUDE_CODE_SHA512_X64" ;; \
      *) echo "unsupported architecture $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/cc.tgz "https://registry.npmjs.org/@anthropic-ai/claude-code-${target}/-/claude-code-${target}-${CLAUDE_CODE_VERSION}.tgz"; \
    got="sha512-$(openssl dgst -sha512 -binary /tmp/cc.tgz | base64 -w0)"; \
    [ "$got" = "$want" ] || { echo "Claude Code tarball integrity mismatch: $got" >&2; exit 1; }; \
    tar -xzf /tmp/cc.tgz -C /tmp package/claude; \
    install -m 0755 /tmp/package/claude /usr/local/bin/claude; \
    rm -rf /tmp/cc.tgz /tmp/package

# pi, as its GitHub release ships it (github.com/earendil-works/pi): the standalone build for the
# platform, checked against the release's SHA256SUMS. It keeps its docs and assets beside it.
ARG PI_VERSION=1.0.2
ARG PI_SHA256_ARM64=3321ccdc3ff38d6c52274bdab28246e06434618d1988a54e99cce45e535a013c
ARG PI_SHA256_X64=0d7687a6a9fcbaa88ff664cb6b28683ce9ee3e028931b55eb48a70ae9a285d18

RUN set -eu; \
    arch="$(dpkg --print-architecture)"; \
    case "$arch" in \
      arm64) target=linux-arm64; want="$PI_SHA256_ARM64" ;; \
      amd64) target=linux-x64; want="$PI_SHA256_X64" ;; \
      *) echo "unsupported architecture $arch" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /tmp/pi.tgz "https://github.com/earendil-works/pi/releases/download/v${PI_VERSION}/pi-${target}.tar.gz"; \
    echo "$want  /tmp/pi.tgz" | sha256sum -c -; \
    tar -xzf /tmp/pi.tgz -C /opt; \
    ln -s /opt/pi/pi /usr/local/bin/pi; \
    rm /tmp/pi.tgz

# Nothing phones home (each harness's own switches; the network allows only the proxy anyway).
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 \
    DISABLE_TELEMETRY=1 \
    DISABLE_ERROR_REPORTING=1 \
    DISABLE_AUTOUPDATER=1 \
    CLAUDE_CODE_DISABLE_OFFICIAL_MARKETPLACE_AUTOINSTALL=1 \
    PI_OFFLINE=1 \
    PI_SKIP_VERSION_CHECK=1 \
    PI_TELEMETRY=0

# The harnesses' home directories, owned by the agent's user, so a read-only skills or config
# mount inside them leaves the rest writable.
RUN mkdir -p /home/node/.claude /home/node/.pi/agent && chown -R node:node /home/node/.claude /home/node/.pi

USER node
RUN claude --version && pi --version
WORKDIR /work
